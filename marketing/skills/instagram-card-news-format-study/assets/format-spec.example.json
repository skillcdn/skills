{
  "account": { "handle": "example-account", "read_on": "0000-00-00", "visible_posts": 12, "posts_read": 12 },
  "categories": [
    { "name": "<category in the account's words>", "share": 0.5, "example": "<a caption's first line, to identify the post>" }
  ],
  "cadence": { "per_day": "<counted>", "hours": "<first to last, in the account's market's time zone>", "pinned_left_out": ["<post id>"] },
  "canvas": {
    "ratio": "4:5",
    "documented": { "max_width": 1080, "ratios": "<as the help page gives them>", "looked_up": "0000-00-00" },
    "size": { "width": 1080, "height": 1350 },
    "slides_per_post": { "min": 1, "max": 10, "typical": 7 },
    "other_ratios": [
      { "ratio": "1:1", "size": { "width": 1080, "height": 1080 }, "for": ["<kind>"], "seen_in": ["<post id>"] }
    ]
  },
  "kinds": {
    "story": {
      "builds": [
        { "name": "feature", "slides": { "min": 7, "max": 10 }, "text_on": "sentences on photos", "typical_order": ["cover", "story", "story", "photo-only", "story", "story", "story"], "order": "varies", "seen_in": ["<post id>", "<post id>"] },
        { "name": "photo story", "slides": { "min": 5, "max": 9 }, "text_on": "talk boxes on photos", "order": "varies", "seen_in": ["<post id>"] },
        { "name": "short news", "slides": { "min": 2, "max": 3 }, "text_on": "the caption; the cover only on slides", "order": "fixed", "seen_in": ["<post id>"] }
      ]
    },
    "report": {
      "builds": [
        { "name": "frame stack", "slides": { "min": 3, "max": 5 }, "text_on": "the material's own captions; the account's text on the cover only", "typical_order": ["cover", "frame stack", "frame stack", "frame stack"], "order": "fixed", "seen_in": ["<post id>", "<post id>"] }
      ]
    },
    "list": { "builds": [{ "name": "weekly picks", "slides": { "min": 8, "max": 10 }, "text_on": "lead slides", "order": "varies", "seen_in": ["<post id>"], "tentative": true }] },
    "event": { "builds": [{ "name": "sponsored", "slides": { "min": 4, "max": 6 }, "text_on": "story slides and a poster", "order": "fixed", "seen_in": ["<post id>"], "tentative": true }] }
  },
  "cover": {
    "photo": "full-bleed, gradient over the lower part (estimate)",
    "label": { "kind": "the account's series name; never reused", "color": "#RRGGBB", "weight": 700, "italic": false, "width": "normal", "size_px": 30, "x": "7-45%", "y": "70-73%", "estimate": true },
    "headline": { "lines": 2, "weight": 800, "size_px": 72, "color": "#FFFFFF", "style": "news title, the subject in the first line", "estimate": true },
    "mark": { "kind": "the account's logo; its place and size only, never reused", "x": "45-55%", "y": "92-96%", "height_px": 45, "estimate": true },
    "variants": [
      { "name": "list cover", "differs": "a two-line label at the top, centered headline", "for": ["list"], "seen_in": ["<post id>"] },
      { "name": "sponsored cover", "differs": "the sponsor's name in a white box where the label sits, three lines", "for": ["event/sponsored"], "seen_in": ["<post id>"] }
    ]
  },
  "slide_types": [
    {
      "name": "story",
      "anatomy": { "photo": "full-bleed, gradient at the bottom", "sub": { "lines": 1, "size_px": 40, "weight": 700, "y": "74-78%" }, "body": { "lines": 3, "size_px": 30, "weight": 400, "line_height": 1.5, "y": "81-92%", "width": "<a condensed width where measured, as a percentage>" }, "estimate": true },
      "carries": "one step of the story: a fact, its background, a turn, what it means",
      "seen_in": ["<post id>", "<post id>"]
    },
    { "name": "photo-only", "anatomy": { "photo": "full-bleed, no text" }, "carries": "a photo with nothing to add", "seen_in": ["<post id>"] },
    {
      "name": "frame stack",
      "anatomy": { "photo": "two 16:9 frames kept whole at their own ratio, stacked, on a flat background", "frames_per_slide": 2, "frame_edges": [{ "y": "5-50%" }, { "y": "50-95%" }], "marks_kept": ["broadcaster's logo", "program label", "subtitles"], "background": "#000000", "own_text": "none", "material_text": "the frames' subtitles and labels, as aired", "estimate": true },
      "carries": "consecutive moments of a report or footage, told by the material's own captions",
      "seen_in": ["<post id>", "<post id>"]
    },
    { "name": "collage", "anatomy": { "photo": "two photos stacked", "sub_and_body": "as story" }, "carries": "two related photos with one step", "seen_in": ["<post id>"], "tentative": true },
    { "name": "lead", "anatomy": { "sub": { "lines": 2, "y": "70-79%" }, "body": { "lines": 2, "y": "81-88%" }, "tag": "source, top-right, small" }, "carries": "one item of a list, with its source", "seen_in": ["<post id>"], "tentative": true },
    { "name": "poster", "anatomy": { "photo": "full-bleed, dim overlay", "name": { "lines": 1, "size_px": 30, "weight": 700, "y": "40-44%" }, "dates": { "lines": 1, "size_px": 96, "weight": 800, "y": "48-58%" }, "estimate": true }, "carries": "an event's name and dates", "seen_in": ["<post id>"], "tentative": true }
  ],
  "elements": [
    { "name": "serif note", "rides_on": ["story"], "anatomy": { "face": "serif", "lines": { "min": 3, "max": 4 }, "position": "the photo's empty area, mostly top-right" }, "carries": "a side fact, a person's introduction, the account's aside", "seen_in": ["<post id>", "<post id>"] },
    { "name": "inset", "rides_on": ["story"], "anatomy": { "shape": "a rectangle on the photo" }, "carries": "the thing a sentence names (a cover, a poster, an archive photo)", "seen_in": ["<post id>"] },
    { "name": "talk box", "rides_on": ["photo-only"], "anatomy": { "box": "white, black text", "lines": 2, "count": { "min": 1, "max": 2 }, "placement": "staggered" }, "carries": "a reaction, a reader's view, a date and a place", "seen_in": ["<post id>"] }
  ],
  "density": {
    "cover": { "headline_chars_per_line": { "median": 10, "middle_half": [8, 12], "range": [5, 15] } },
    "story": { "sub_chars": { "median": 12, "range": [6, 16] }, "lines": { "typical": 3, "range": [3, 3] }, "sentences": { "typical": 2, "range": [2, 4] }, "chars_per_line": { "median": 40, "middle_half": [36, 44] }, "chars_per_sentence": { "median": 45, "middle_half": [38, 55] }, "one_fact_per_sentence": false, "detail_goes_to": "caption" },
    "serif note": { "lines": { "typical": 3, "range": [3, 4] }, "chars_per_line": { "median": 18, "range": [12, 22] } },
    "talk box": { "lines": 2, "chars_per_line": { "median": 20 } }
  },
  "register": {
    "headline": { "right": "a news title with the subject in the first line", "wrong": "a teaser that withholds the subject" },
    "sub": { "right": "a noun phrase without a period, or a short declarative", "wrong": "an explanation of the slide" },
    "body": { "right": "<the slides' speech level>, one level per post, <the share of sentence-final noun phrases>", "wrong": "explanatory closers, emoji, exclamation marks, a call to action", "split": { "default": "<level used in most posts>", "other": "<level> in <n> post(s), when it ends on a question to the reader" } },
    "serif note": { "right": "<voice of the note>", "wrong": "<what would sound wrong>" },
    "talk box": { "right": "<voice of the boxes>", "wrong": "<what would sound wrong>" },
    "caption": { "right": "<the caption's speech level>, a connective the voice favors between facts", "wrong": "the slides' voice" }
  },
  "caption": {
    "parts": ["facts with the date and the outlet", "context", "a closing line", "credit line", "mentions, one per line", "information block for an event"],
    "credit_line_pattern": "<the exact pattern: a marker, the word for photo, a separator, then the sources>",
    "info_block_pattern": "<name | value, three lines>",
    "hashtags": false
  },
  "variants_by_content": {
    "one step of the story": "story",
    "a side fact or a person's introduction": "serif note",
    "the thing a sentence names": "inset",
    "two related photos": "collage",
    "a reaction, a date and a place": "talk box",
    "an event's name and dates": "poster",
    "a photo with nothing to add": "photo-only",
    "moments of a report or footage, as aired": "frame stack"
  },
  "never": [
    { "statement": "no call to action on a story slide", "kind": "story", "posts_read": 6 },
    { "statement": "no number as a large overlay", "kind": "story/feature", "posts_read": 3 },
    { "statement": "no text of the account's after the cover, and no frame cropped", "kind": "report/frame stack", "posts_read": 2 }
  ],
  "fonts": {
    "display": { "closest_free": "<sans family>", "load": "<the family's documented CDN URL>", "weights": [400, 700, 800], "guess": false },
    "serif": { "closest_free": "<serif family>", "load": "<css2 API URL>", "weights": [500], "guess": true },
    "label": { "closest_free": "<label family>", "load": "<css2 API URL>", "weights": [700], "guess": true }
  },
  "colors": { "label": "#RRGGBB", "text": "#FFFFFF", "background": "#000000", "gradient_bottom": "rgba(0,0,0,0.45)", "dim": "rgba(0,0,0,0.4)", "estimate": true },
  "posts_read": [{ "id": "<post id>", "kind": "story", "build": "feature", "slides": 7 }, { "id": "<post id>", "kind": "report", "build": "frame stack", "slides": 4 }]
}
